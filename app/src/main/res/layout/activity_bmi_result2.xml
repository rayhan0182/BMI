<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#CFECFF"
    tools:context=".Bmi_Result">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your BMI Result"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="25dp"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/first_cons"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/corner_radius2"
        >
        <TextView
            android:id="@+id/result_show"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:text="45.35"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/circle"
            android:layout_marginTop="20dp"
            />

        <TextView
            android:id="@+id/user_condition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="user physical condition"
            android:layout_marginTop="7dp"
            android:textSize="17sp"
            android:textColor="@color/black"
            android:layout_gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/result_show"
            android:layout_marginBottom="25dp"
            />


        <TextView
            android:id="@+id/bmichart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:layout_marginTop="20sp"
            android:gravity="center"
            android:layout_gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/user_condition"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>




</LinearLayout>